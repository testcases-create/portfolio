{
  "name": "portfolio",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check-content -- --strict && astro build",
    "build:preview": "ALLOW_PLACEHOLDERS=1 astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check-content": "node --experimental-strip-types scripts/check-content.ts",
    "palette": "node scripts/palette.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "budgets": "node --experimental-strip-types scripts/budgets.ts",
    "capture-poster": "node --experimental-strip-types scripts/capture-poster.ts",
    "og-images": "node --experimental-strip-types scripts/og-images.ts",
    "resume-pdf": "node --experimental-strip-types scripts/resume-pdf.ts",
    "sample-attention": "node --experimental-strip-types scripts/sample-attention.ts",
    "precompute-attention": "python3 scripts/precompute-attention.py",
    "screenshots": "node --experimental-strip-types scripts/screenshots.ts",
    "profile-frames": "node --experimental-strip-types scripts/profile-frames.ts",
    "bench": "vitest run src/graphics/sim.cpu.perf.test.ts",
    "content-guide": "node --experimental-strip-types scripts/content-guide.ts && prettier --write CONTENT_GUIDE.md --log-level warn"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "astro": "^7.3.5",
    "gsap": "^3.15.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  }
}
