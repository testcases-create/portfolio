---
import Base from '../layouts/Base.astro';
import HomeContent from '../components/HomeContent.astro';
import { site } from '../lib/site';
import { strip } from '../lib/placeholders';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: strip(site.name),
  jobTitle: strip(site.current.title),
  worksFor: { '@type': 'Organization', name: strip(site.current.company) },
  url: strip(site.siteUrl),
  email: `mailto:${strip(site.links.email)}`,
  sameAs: [site.links.github, site.links.linkedin, site.links.blog]
    .filter(Boolean)
    .map((l) => strip(l ?? '')),
};
---

<Base
  title={strip(site.name)}
  description={site.positioning}
  formation="data"
  ogImage="/og/home.png"
  jsonLd={jsonLd}
>
  <HomeContent />
</Base>
