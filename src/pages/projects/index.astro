---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Edit from '../../components/Edit.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const areaLabel = { sde: 'SDE', llm: 'LLM', ml: 'AI/ML' } as const;
---

<Base title="Work" description="Every project, with measured outcomes and how they were measured.">
  <h1>Work</h1>
  <ul class="rows">
    {projects.map(({ id, data }) => (
      <li>
        <h2>
          <a href={`/projects/${id}/`}>
            <Edit text={data.title} />
          </a>
        </h2>
        <p class="tags">
          {data.areas.map((a) => (
            <span class="area" data-area={a}>
              {areaLabel[a]}
            </span>
          ))}
        </p>
        <p class="prose">
          <Edit text={data.summary} />
        </p>
      </li>
    ))}
  </ul>
</Base>

<style>
  .rows {
    display: grid;
    gap: var(--space-7);
    max-width: 44rem;
    margin: var(--space-7) 0 0;
    padding: 0;
    list-style: none;
  }

  h2 {
    font-size: var(--step-sub);
  }

  .tags {
    display: flex;
    gap: var(--space-4);
    margin-block: var(--space-2);
  }
</style>
