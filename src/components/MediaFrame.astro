---
// A project image, or until one exists, a neutral frame at the right aspect
// ratio captioned with exactly what belongs there.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Edit from './Edit.astro';
import { strip } from '../lib/placeholders';

interface Props {
  media: { src?: ImageMetadata | undefined; alt: string; ratio: string; placeholder?: string | undefined };
  widths?: number[];
  sizes?: string;
}
const { media, widths = [480, 960, 1440], sizes = '(min-width: 900px) 40vw, 100vw' } = Astro.props;
---

<figure class="frame" style={`aspect-ratio: ${media.ratio}`}>
  {media.src ? (
    <Image src={media.src} alt={strip(media.alt)} widths={widths} sizes={sizes} />
  ) : (
    <figcaption class="small">
      <Edit text={media.placeholder ?? media.alt} />
    </figcaption>
  )}
</figure>

<style>
  .frame {
    margin: 0;
    display: grid;
    place-items: center;
    background: var(--raised);
    border: 1px dashed var(--line);
  }

  /* An image is cropped to the frame; a placeholder caption may grow it instead of being cut off. */
  .frame:has(img) {
    overflow: hidden;
  }

  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  figcaption {
    max-width: 36ch;
    padding: var(--space-3);
    text-align: center;
    color: var(--muted);
  }
</style>
