---
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import SiteHeader from '../components/SiteHeader.astro';
import WorldSlot from '../components/WorldSlot.astro';
import { strip } from '../lib/placeholders';
import { site } from '../lib/site';
import type { Formation, Mode } from '../lib/world-config';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/print.css';

interface Props {
  title: string;
  description: string;
  formation?: Formation;
  mode?: Mode;
  /** Role lenses point their canonical URL at Home. */
  canonicalPath?: string;
  /** Open Graph image, a path under /og/. */
  ogImage?: string;
  /** Structured data for search engines. */
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  /** Presentation mode: no site header or footer. */
  bare?: boolean;
}
const {
  title,
  description,
  formation = 'data',
  mode = 'full',
  canonicalPath,
  ogImage = '/og/default.png',
  jsonLd,
  noindex = false,
  bare = false,
} = Astro.props;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const image = new URL(ogImage, Astro.site);
const fullTitle = title === strip(site.name) ? title : `${title} · ${strip(site.name)}`;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{strip(fullTitle)}</title>
    <meta name="description" content={strip(description)} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={strip(fullTitle)} />
    <meta property="og:description" content={strip(description)} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Demo builds publish the example persona: keep every page out of search results. */}
    {(noindex || import.meta.env.DEMO === '1') && <meta name="robots" content="noindex, nofollow" />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <meta name="color-scheme" content="dark light" />
    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-source-serif" />
    <script is:inline>
      // Before first paint: follow the device's light or dark setting, so there is
      // no flash, and decide whether the one-time hero intro plays (never with
      // reduced motion). boot.ts keeps the theme in step if the setting changes.
      (() => {
        const root = document.documentElement;
        root.dataset.theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        let seen = false;
        try {
          seen = sessionStorage.getItem('intro:seen') === '1';
        } catch {
          /* storage blocked: play the intro */
        }
        if (!seen && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.classList.add('intro');
          // Any input skips the intro, even before its script has loaded.
          const skip = () => {
            root.dataset.introSkip = '1';
            for (const t of inputs) removeEventListener(t, skip, true);
          };
          const inputs = ['pointerdown', 'keydown', 'wheel', 'touchstart'];
          for (const t of inputs) addEventListener(t, skip, { capture: true, passive: true });
        }
      })();
    </script>
    <slot name="head" />
    <ClientRouter />
  </head>
  <body data-world-formation={formation} data-world-mode={mode}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <WorldSlot />
    {bare ? null : mode === 'band' ? (
      // Project pages: the header and the world's band share one block of fixed height,
      // so the band is placed by CSS alone and never shifts the layout.
      <div class="band-top" data-world-band>
        <SiteHeader />
      </div>
    ) : (
      <SiteHeader />
    )}
    <main id="main" class:list={[!bare && 'wrap']}>
      <slot />
    </main>
    {!bare && (
      <footer class="site-footer wrap">
        <ul class="footer-links">
          <li>
            <a href={`mailto:${strip(site.links.email)}`}>Email</a>
          </li>
          <li>
            <a href={strip(site.links.linkedin)}>LinkedIn</a>
          </li>
          <li>
            <a href={strip(site.links.github)}>GitHub</a>
          </li>
          <li>
            <a href="/resume.pdf">Résumé (PDF)</a>
          </li>
        </ul>
        <button
          type="button"
          class="button"
          data-action="stats"
          aria-expanded="false"
          aria-controls="world-stats"
        >
          Stats for nerds
        </button>
        <section id="world-stats" class="world-stats" aria-label="Graphics stats" hidden>
          <label>
            Graphics quality
            <select id="world-tier">
              <option value="auto">Automatic</option>
              <option value="high">High (WebGPU)</option>
              <option value="medium">Medium (WebGL2)</option>
              <option value="low">Low (CPU)</option>
              <option value="poster">Still image</option>
            </select>
          </label>
          <dl></dl>
        </section>
      </footer>
    )}
    <script>
      import '../scripts/boot';
    </script>
  </body>
</html>

<style>
  main {
    position: relative;
    z-index: 1;
    padding-block: var(--space-7) var(--space-9);
  }

  .band-top {
    height: var(--band-total);
  }

  .site-footer {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: flex-start;
    padding-block: var(--space-6) var(--space-8);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0 auto 0 0;
    padding: 0;
    list-style: none;
  }

  .footer-links a {
    display: inline-block;
    padding-block: var(--space-2);
  }

  .world-stats {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--raised);
    font-size: var(--step-small);
    font-variant-numeric: tabular-nums;
  }

  .world-stats label {
    display: grid;
    gap: var(--space-1);
  }

  .world-stats select {
    min-height: 2.5rem;
    font: inherit;
    color: var(--text);
    background: var(--ground);
    border: 1px solid var(--line);
    border-radius: var(--radius-control);
  }

  .world-stats :global(dl) {
    display: grid;
    grid-template-columns: auto auto;
    gap: var(--space-1) var(--space-5);
    margin: 0;
  }

  .world-stats :global(dt) {
    color: var(--muted);
  }

  .world-stats :global(dd) {
    margin: 0;
    text-align: right;
  }
</style>
