---
// Development and preview builds only: a 1200×630 social card per page,
// screenshotted by scripts/og-images.ts into public/og/.
import type { GetStaticPaths } from 'astro';
import { Font } from 'astro:assets';
import { allProjects, AREA_LABEL } from '../lib/projects';
import { strip } from '../lib/placeholders';
import { site } from '../lib/site';
import '../styles/tokens.css';

export const getStaticPaths = (async () => {
  const projects = await allProjects();
  return [
    {
      params: { card: 'home' },
      props: { title: strip(site.name), sub: strip(site.roleLine), areas: [] as string[] },
    },
    {
      params: { card: 'default' },
      props: { title: strip(site.name), sub: strip(site.positioning), areas: [] as string[] },
    },
    ...projects.map((p) => ({
      params: { card: p.id },
      props: {
        title: strip(p.data.title),
        sub: strip(p.data.outcomeHeadline),
        areas: p.data.areas.map((a) => a),
      },
    })),
  ];
}) satisfies GetStaticPaths;

const { title, sub, areas } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-source-serif" />
  </head>
  <body>
    <div class="card">
      <div class="text">
        <p class="name">{strip(site.name)}</p>
        <p class="title">{title}</p>
        <p class="sub">{sub}</p>
        <p class="areas">
          {areas.map((a) => (
            <span data-area={a}>{AREA_LABEL[a as 'sde']}</span>
          ))}
        </p>
      </div>
    </div>
  </body>
</html>

<style>
  body {
    margin: 0;
    background: var(--ground);
    color: var(--text);
    font-family: var(--font-archivo), sans-serif;
  }

  .card {
    width: 1200px;
    height: 630px;
    box-sizing: border-box;
    padding: 64px 72px;
    display: flex;
    align-items: flex-end;
    background:
      linear-gradient(90deg, var(--ground) 38%, transparent 70%),
      url('/poster/world-dark.webp') right center / cover no-repeat;
  }

  .text {
    max-width: 760px;
    display: grid;
    gap: 18px;
  }

  .name {
    margin: 0;
    font-size: 26px;
    font-weight: 620;
    font-variation-settings: 'wdth' 112;
    color: var(--muted);
  }

  .title {
    margin: 0;
    font-size: 60px;
    line-height: 1.04;
    font-weight: 620;
    font-variation-settings: 'wdth' 110;
  }

  .sub {
    margin: 0;
    font-size: 26px;
    line-height: 1.3;
    color: var(--muted);
  }

  .areas {
    margin: 6px 0 0;
    display: flex;
    gap: 28px;
    font-size: 22px;
  }

  .areas span::before {
    content: '';
    display: inline-block;
    width: 14px;
    height: 14px;
    margin-right: 10px;
    border-radius: 50%;
    background: var(--c);
  }

  [data-area='sde'] {
    --c: var(--sde);
  }

  [data-area='llm'] {
    --c: var(--llm);
  }

  [data-area='ml'] {
    --c: var(--ml);
  }
</style>
